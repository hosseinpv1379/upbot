# === Telegram API credentials (https://my.telegram.org) ===
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# === Bot client (created via @BotFather) ===
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# === Optional user client session string (generated with login.py) ===
# Allows uploads up to 2 GB (4 GB on Telegram Premium) instead of the bot's 2 GB cap.
# Leave empty to upload with the bot client only.
USER_SESSION=

# === Admins allowed to use the bot (comma separated Telegram user IDs) ===
ADMIN_IDS=11111111,22222222

# === Proxy used by the Telegram (MTProto) connection, both clients ===
# Format: socks5://user:pass@host:port  (socks4:// and http:// also supported)
# Leave empty to connect without a proxy.
TG_PROXY=socks5://user:pass@127.0.0.1:1080

# === Proxy used only for downloading files (optional, defaults to TG_PROXY if unset) ===
DL_PROXY=

# === Storage paths ===
DOWNLOAD_DIR=downloads
DB_PATH=uploader.db
LOG_DIR=logs

# === Limits & concurrency ===
MAX_FILE_SIZE_GB=2.0
DOWNLOAD_CONCURRENCY=2
UPLOAD_CONCURRENCY=1
SEGMENTED_DOWNLOAD_CONNECTIONS=4
FAST_UPLOAD_CONNECTIONS=4

# === Progress UI ===
PROGRESS_UPDATE_INTERVAL=4.0

# === Captions ===
CAPTION_LIMIT_DEFAULT=1024
CAPTION_LIMIT_PREMIUM=4096

# === Downloader ===
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Uploader/1.0
